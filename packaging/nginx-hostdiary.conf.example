# Example: serve hostdiary behind nginx Basic authentication.
# Place this inside an existing HTTPS server { ... } block (or include it).
# Create the password file outside the served tree using your usual procedure.
# Defining add_header here prevents inheritance of add_header from server/http.
# Repeat any headers set at server level here, such as HSTS.

location = /hostdiary {
    return 308 /hostdiary/;
}

location ^~ /hostdiary/ {
    alias /var/lib/hostdiary/public/;
    auth_basic "Resource history";
    auth_basic_user_file /etc/nginx/hostdiary.htpasswd;
    add_header Cache-Control "no-cache" always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    autoindex off;
}
